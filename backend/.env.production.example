# Production Environment Configuration
# Copy this file to .env.production and fill in all values
# NEVER commit this file with real secrets!

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=den_den_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=den_den
DB_POOL_MAX=20

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64_CHAR_BASE64_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_BASE64_REFRESH_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ===========================================
# OTP Provider Configuration
# ===========================================
# Options: console, twilio, sendgrid
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=CHANGE_ME
SENDGRID_API_KEY=CHANGE_ME

# ===========================================
# S3 / Object Storage Configuration
# ===========================================
# For production, use AWS S3 or compatible (Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=den-den-attachments-prod

# ===========================================
# Push Notifications Configuration
# ===========================================
# Get from Firebase Console > Project Settings > Cloud Messaging
FCM_SERVER_KEY=CHANGE_ME

# Get from Apple Developer Console > Certificates, Identifiers & Profiles
APNS_KEY_ID=CHANGE_ME
APNS_TEAM_ID=CHANGE_ME
APNS_KEY_PATH=/app/certs/AuthKey_${APNS_KEY_ID}.p8

# ===========================================
# Application Configuration
# ===========================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ===========================================
# Security Configuration
# ===========================================
# Enable certificate pinning in production
ENABLE_CERT_PINNING=true
CERT_PIN_PRIMARY=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CERT_PIN_BACKUP=sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Monitoring & Tracing
# ===========================================
# ENABLE_METRICS=true
# METRICS_PORT=9090
# JAEGER_ENDPOINT=http://jaeger:14268/api/traces